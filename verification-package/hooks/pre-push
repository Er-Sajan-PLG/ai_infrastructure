#!/usr/bin/env bash
#
# Pre-push hook: branch enforcement before push.
#
# Blocks push if:
#   - On a protected branch (main, master, develop, release/*, hotfix/*)
#   - Branch name doesn't match naming convention
#   - Agent detected without agent/ prefix
#
# Installed by scripts/install-verification.sh.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

GUARD_CONFIG="$REPO_ROOT/verification-package/config/branch-guard.conf"
if [ -f "$GUARD_CONFIG" ]; then
    source "$GUARD_CONFIG"
else
    PROTECTED_BRANCHES=("main" "master")
    BRANCH_PATTERN="^(feat|fix|chore|docs|refactor|test|ci|build|perf|revert)/[a-z0-9][a-z0-9-]*$"
    AGENT_ENFORCEMENT=1
    AGENT_PREFIX="agent"
fi

BRANCH=$(git branch --show-current)

# Check protected branches
for pattern in "${PROTECTED_BRANCHES[@]}"; do
    if [[ "$BRANCH" =~ ^$pattern$ ]]; then
        echo "" >&2
        echo "pre-push FAILED: '$BRANCH' is a protected branch." >&2
        echo "Push to a feature branch instead:" >&2
        echo "  git checkout -b <type>/<description>" >&2
        echo "  git push -u origin <type>/<description>" >&2
        exit 1
    fi
done

# Check naming convention
if ! [[ "$BRANCH" =~ $BRANCH_PATTERN ]]; then
    echo "" >&2
    echo "pre-push FAILED: branch '$BRANCH' does not match naming convention." >&2
    echo "Expected: <type>/<description>" >&2
    echo "Types: feat fix chore docs refactor test ci build perf revert" >&2
    exit 1
fi

# Agent enforcement
if [ "${AGENT_ENFORCEMENT:-1}" = "1" ]; then
    IS_AGENT=false
    if [ -n "${OPENCODE_SESSION_ID:-}" ] || [ -n "${CLAUDE_SESSION_ID:-}" ] || \
       [ -n "${AGENT_ID:-}" ] || [ -n "${AI_AGENT:-}" ]; then
        IS_AGENT=true
    fi
    PARENT_CMD=$(ps -o comm= -p $PPID 2>/dev/null || echo "")
    if echo "$PARENT_CMD" | grep -qiE '(opencode|claude|cursor|copilot|codex)'; then
        IS_AGENT=true
    fi

    if [ "$IS_AGENT" = "true" ]; then
        if [[ ! "$BRANCH" == $AGENT_PREFIX/* ]]; then
            echo "" >&2
            echo "pre-push FAILED: agent detected but branch '$BRANCH'" >&2
            echo "does not have '$AGENT_PREFIX/' prefix." >&2
            echo "Agents must use: $AGENT_PREFIX/<type>/<description>" >&2
            exit 1
        fi
    fi
fi

echo "pre-push: branch '$BRANCH' — OK"
exit 0
