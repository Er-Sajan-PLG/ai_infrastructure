#!/usr/bin/env bash
#
# Pre-commit hook: fast, staged-files-only checks.
#
# Runs in ~10s on staged files. Format, syntax, cheap lint, config validation,
# fast secret detection. No heavy suites — those run in pre-push and CI.
#
# Installed by scripts/install-verification.sh. Do not edit .git/hooks/ directly.

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

STAGED=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED" ]; then
    exit 0
fi

fail() {
    echo "" >&2
    echo "pre-commit FAILED: $1" >&2
    echo "Fix the problem, re-stage, and commit again." >&2
    exit 1
}

# --- 0. Branch enforcement (config-driven) -----------------------------------
GUARD_CONFIG="$REPO_ROOT/verification-package/config/branch-guard.conf"
if [ -f "$GUARD_CONFIG" ]; then
    source "$GUARD_CONFIG"
else
    PROTECTED_BRANCHES=("main" "master")
    BRANCH_PATTERN="^(feat|fix|chore|docs|refactor|test|ci|build|perf|revert)/[a-z0-9][a-z0-9-]*$"
    AGENT_ENFORCEMENT=1
    AGENT_PREFIX="agent"
    BLOCK_REPEATED_COMMITS=1
    MAX_COMMITS_PER_BRANCH=10
fi

BRANCH=$(git branch --show-current)

# Check protected branches (exact match + regex patterns)
for pattern in "${PROTECTED_BRANCHES[@]}"; do
    if [[ "$BRANCH" =~ ^$pattern$ ]]; then
        echo "" >&2
        echo "pre-commit FAILED: '$BRANCH' is a protected branch." >&2
        echo "New work must start with a new branch:" >&2
        echo "  git checkout -b <type>/<description>" >&2
        echo "This applies even within a running session." >&2
        exit 1
    fi
done

# Check branch naming convention
if ! [[ "$BRANCH" =~ $BRANCH_PATTERN ]]; then
    echo "" >&2
    echo "pre-commit FAILED: branch '$BRANCH' does not match naming convention." >&2
    echo "Expected: <type>/<description>" >&2
    echo "Types: feat fix chore docs refactor test ci build perf revert" >&2
    echo "Example: feat/branch-enforcement" >&2
    exit 1
fi

# Agent enforcement: detect if running as AI agent
if [ "${AGENT_ENFORCEMENT:-1}" = "1" ]; then
    IS_AGENT=false
    if [ -n "${OPENCODE_SESSION_ID:-}" ] || [ -n "${CLAUDE_SESSION_ID:-}" ] || \
       [ -n "${AGENT_ID:-}" ] || [ -n "${AI_AGENT:-}" ]; then
        IS_AGENT=true
    fi
    PARENT_CMD=$(ps -o comm= -p $PPID 2>/dev/null || echo "")
    if echo "$PARENT_CMD" | grep -qiE '(opencode|claude|cursor|copilot|codex)'; then
        IS_AGENT=true
    fi

    if [ "$IS_AGENT" = "true" ]; then
        if [[ ! "$BRANCH" == $AGENT_PREFIX/* ]]; then
            echo "" >&2
            echo "pre-commit FAILED: agent detected but branch '$BRANCH'" >&2
            echo "does not have '$AGENT_PREFIX/' prefix." >&2
            echo "Agents must use: $AGENT_PREFIX/<type>/<description>" >&2
            echo "Example: $AGENT_PREFIX/feat/my-work" >&2
            exit 1
        fi
    fi
fi

# Block repeated commits on the same branch
if [ "${BLOCK_REPEATED_COMMITS:-1}" = "1" ]; then
    COMMIT_COUNT=$(git rev-list --count HEAD 2>/dev/null || echo 0)
    if [ "$COMMIT_COUNT" -gt "${MAX_COMMITS_PER_BRANCH:-10}" ]; then
        echo "" >&2
        echo "pre-commit WARNING: $COMMIT_COUNT commits on '$BRANCH'." >&2
        echo "Consider creating a new branch for new work." >&2
    fi
fi

# --- 1. Python: syntax + lint + format ------------------------------------
if echo "$STAGED" | grep -qE '\.py$'; then
    PY="${VENV:-.venv}/bin/python"
    [ -x "$PY" ] || PY="python3"

    echo "pre-commit: python syntax check"
    echo "$STAGED" | grep '\.py$' | while read -r f; do
        "$PY" -m py_compile "$f" 2>/dev/null || fail "syntax error in $f"
    done

    if command -v ruff >/dev/null 2>&1; then
        echo "pre-commit: ruff lint"
        ruff check "$STAGED" --fix 2>/dev/null || fail "ruff found lint errors"
    elif [ -x ".venv/bin/ruff" ]; then
        echo "pre-commit: ruff lint"
        .venv/bin/ruff check "$STAGED" 2>/dev/null || fail "ruff found lint errors"
    fi

    if command -v black >/dev/null 2>&1; then
        echo "pre-commit: black format check"
        black --check "$STAGED" 2>/dev/null || fail "black would reformat (run: black .)"
    elif [ -x ".venv/bin/black" ]; then
        echo "pre-commit: black format check"
        .venv/bin/black --check "$STAGED" 2>/dev/null || fail "black would reformat (run: black .)"
    fi
fi

# --- 2. TypeScript/JavaScript: syntax + lint -------------------------------
if echo "$STAGED" | grep -qE '\.(ts|tsx|js|jsx)$'; then
    if command -v npx >/dev/null 2>&1; then
        echo "pre-commit: eslint"
        npx eslint "$STAGED" 2>/dev/null || fail "eslint found errors"
    fi
fi

# --- 3. Config validation --------------------------------------------------
if echo "$STAGED" | grep -qE '\.(json|toml|ya?ml)$'; then
    echo "pre-commit: config syntax"
    echo "$STAGED" | grep -E '\.(json|toml|ya?ml)$' | while read -r f; do
        case "$f" in
            *.json) python3 -c "import json; json.load(open('$f'))" 2>/dev/null || fail "invalid JSON: $f" ;;
            *.toml) python3 -c "import tomllib; tomllib.load(open('$f','rb'))" 2>/dev/null || fail "invalid TOML: $f" ;;
            *.yaml|*.yml) python3 -c "import yaml; yaml.safe_load(open('$f'))" 2>/dev/null || fail "invalid YAML: $f" ;;
        esac
    done
fi

# --- 4. Secret detection (fast, staged content only) -----------------------
if command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks (staged)"
    gitleaks protect --staged --no-banner --redact --exit-code 1 2>/dev/null \
        || fail "gitleaks found a secret in staged changes"
fi

# --- 5. Trailing whitespace + conflict markers -----------------------------
echo "pre-commit: whitespace + conflict markers"
echo "$STAGED" | while read -r f; do
    [ -f "$f" ] || continue
    grep -nE '^(<<<<<<<|=======|>>>>>>>)' "$f" 2>/dev/null && fail "conflict markers in $f"
    grep -nE ' +$' "$f" 2>/dev/null && fail "trailing whitespace in $f"
done

echo "pre-commit: all checks passed."
exit 0
