#!/usr/bin/env bash
#
# Git pre-commit hook for ai_infrastructure.
#
# Enforces the repository's quality gates locally so that a session cannot
# commit a state that violates the charter. Installed by `make install-hooks`.
#
# Skips the slow gates when nothing relevant changed, so commits stay fast.
#
# Charter references: §4 (honest status), §13 (standards), §18 (testing),
# §21 (definition of done).

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

VENV="${REPO_ROOT}/.venv"
if [ ! -x "${VENV}/bin/python" ]; then
    echo "pre-commit: no virtualenv found at .venv — run 'make setup' first." >&2
    echo "pre-commit: skipping gates (environment not set up)." >&2
    exit 0
fi

# Files staged in this commit.
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED" ]; then
    exit 0
fi

fail() {
    echo "" >&2
    echo "pre-commit FAILED: $1" >&2
    echo "Fix the problem, re-stage, and commit again." >&2
    echo "(Do not use --no-verify to skip a gate; charter §28 forbids" >&2
    echo " weakening checks to obtain a passing result.)" >&2
    exit 1
}

# --- 0. Secrets -----------------------------------------------------------
# Runs first and on EVERY commit, not only Python ones: a credential is most
# likely to arrive in a config, a notebook, or a .env-shaped file, and those
# are exactly the paths a language-scoped check would skip.
#
# gitleaks is an external binary, not a Python package, so unlike every other
# gate here it may simply be absent. A missing scanner is reported and skipped
# rather than silently passing -- an unrun check must never look like a passed
# one (charter §28). CI installs a pinned gitleaks and has no such excuse.
echo "pre-commit: gitleaks (secret scan)"
if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --staged --no-banner --redact --exit-code 1 \
        -c "${REPO_ROOT}/.gitleaks.toml" >/dev/null 2>&1 \
        || fail "gitleaks found a secret in staged changes (run 'gitleaks git --staged --no-banner --redact')"
else
    echo "pre-commit: WARNING - gitleaks not installed; secret scan SKIPPED locally." >&2
    echo "pre-commit: CI still runs it. Install: https://github.com/gitleaks/gitleaks" >&2
fi

# --- 0b. MACP state auto-sync ---------------------------------------------
# Regenerates git-derived blocks (branch, HEAD, session commit lists) inside
# marked sections of state/ files. Idempotent: a second run with no new git
# state changes nothing. Runs early so every downstream gate sees the synced
# record. Stages exactly the files the script modified (--stage) — new files
# still need an explicit `git add` (intentional: new files are a decision).
echo "pre-commit: macp state auto-sync"
"${VENV}/bin/python" scripts/sync_state.py --quiet --stage >/dev/null 2>&1 \
    || fail "state auto-sync failed (run 'make sync-state')"

# --- 1. Python: lint + format --------------------------------------------
if echo "$STAGED" | grep -qE '\.py$'; then
    echo "pre-commit: ruff check"
    "${VENV}/bin/ruff" check . >/dev/null 2>&1 || fail "ruff found lint errors (run 'make lint')"

    echo "pre-commit: black --check"
    "${VENV}/bin/black" --check . >/dev/null 2>&1 || fail "black would reformat (run 'make format')"

    echo "pre-commit: mypy (strict)"
    TARGETS=$(find catalog scripts tests study_pipeline -name '*.py' -not -path '*/.venv/*' 2>/dev/null || true)
    if [ -n "$TARGETS" ]; then
        # MYMYATH mirrors `make typecheck`: entry packages are imported by
        # bare name (charter §31), so mypy needs the same entry directories
        # the Makefile derives. Paths come from make itself, not a copy.
        # shellcheck disable=SC2086
        MYPYPATH="$(make --no-print-directory -s print-entry-paths)" \
            "${VENV}/bin/mypy" $TARGETS >/dev/null 2>&1 || fail "type errors (run 'make typecheck')"
    fi
fi

# --- 2. Tests -------------------------------------------------------------
if echo "$STAGED" | grep -qE '^(catalog|scripts|tests)/.*\.py$'; then
    echo "pre-commit: pytest"
    "${VENV}/bin/pytest" >/dev/null 2>&1 || fail "tests failed (run 'make test')"
fi

# --- 3. Catalog entry contract -------------------------------------------
if echo "$STAGED" | grep -qE '^catalog/'; then
    echo "pre-commit: catalog entry contract"
    "${VENV}/bin/python" scripts/validate_catalog.py >/dev/null 2>&1 \
        || fail "catalog contract violated (run 'make validate')"
fi

# --- 3b. Markdown link integrity ------------------------------------------
# 41 broken links once accumulated here undetected. Docs are a primary
# deliverable, so a dangling reference is a defect, not cosmetics.
if echo "$STAGED" | grep -qE '\.md$'; then
    echo "pre-commit: markdown links"
    "${VENV}/bin/python" scripts/check_links.py --quiet >/dev/null 2>&1 \
        || fail "broken markdown link(s) (run 'make links' to list them)"
fi

# --- 3c. Phase plan vs charter lifecycle ----------------------------------
# docs/phases/phase-1-seed.md once listed DESIGNED and DECIDED in the wrong
# order relative to charter 4, so the drift check rejected a correct DECIDED
# claim. A documented plan that contradicts the charter is a defect.
if echo "$STAGED" | grep -qE '^(docs/phases/|TAXONOMY\.md|AGENTS\.md)'; then
    echo "pre-commit: phase plan vs charter lifecycle"
    "${VENV}/bin/python" scripts/check_phase_plan.py --quiet >/dev/null 2>&1 \
        || fail "documented stage order contradicts charter 4 (run 'make phase-plan')"
fi

# --- 4. Structural checks (charter §31) -----------------------------------
# Entry independence and test collectability. Cheap, and they guard the
# property that makes the catalog reusable rather than merely present.
if echo "$STAGED" | grep -qE '^(catalog/|integrations/|pyproject\.toml)'; then
    echo "pre-commit: catalog entry independence"
    PYTHONPATH="$(cd "$REPO_ROOT" && make --no-print-directory -s print-entry-paths)" \
        "${VENV}/bin/lint-imports" --no-logo >/dev/null 2>&1 \
        || fail "an entry imports something it must not (run 'make independence')"

    echo "pre-commit: test collectability"
    "${VENV}/bin/python" scripts/check_collectability.py --quiet >/dev/null 2>&1 \
        || fail "an entry's tests are not collectable (run 'make collectability')"
fi

# --- 4b. Security: SAST + dependency audit + licences ---------------------
# SAST and licence checks are fast and run on any code or dependency change.
# The dependency AUDIT (pip-audit) needs the network, so it is left to CI:
# a hook that blocks a commit because a remote service is unreachable would
# be disabled within a week.
if echo "$STAGED" | grep -qE '\.py$'; then
    echo "pre-commit: SAST (bandit on production code)"
    PROD=$(find catalog integrations scripts -name '*.py' \
        -not -path '*/tests/*' -not -path '*/examples/*' 2>/dev/null || true)
    if [ -n "$PROD" ]; then
        # shellcheck disable=SC2086
        "${VENV}/bin/python" -m bandit -c pyproject.toml -q -ll $PROD >/dev/null 2>&1 \
            || fail "bandit found a MEDIUM+ issue in production code (run 'make sast')"
    fi
fi

if echo "$STAGED" | grep -qE '(pyproject\.toml|requirements.*\.txt)$'; then
    echo "pre-commit: licence allow-list"
    "${VENV}/bin/python" scripts/check_licenses.py --quiet >/dev/null 2>&1 \
        || fail "a dependency licence is not on the allow-list (run 'make licenses')"
fi

# --- 4c. Accepted-risk register -------------------------------------------
# Runs whenever the register, the roadmap, or the ADRs move: those are the
# files that carry a rationale_ref, and a dangling reference is a defect.
if echo "$STAGED" | grep -qE '^(docs/risks/|docs/decisions/)'; then
    echo "pre-commit: accepted-risk register"
    "${VENV}/bin/python" scripts/check_risks.py --quiet >/dev/null 2>&1 \
        || fail "the risk register is stale or was re-dated without review (run 'make risks')"

    echo "pre-commit: deferred-work register"
    "${VENV}/bin/python" scripts/check_deferred.py --quiet >/dev/null 2>&1 \
        || fail "the deferred register is stale or was re-dated without review (run 'make deferred')"
fi

# --- 5. Governance drift --------------------------------------------------
# The single most important gate: no commit may claim a lifecycle status the
# artifacts on disk do not support (charter §4).
if echo "$STAGED" | grep -qE '^(TAXONOMY\.md|specifications/|catalog/|docs/decisions/)'; then
    echo "pre-commit: governance drift check"
    "${VENV}/bin/python" scripts/repo_status.py --quiet \
        || fail "taxonomy claims exceed artifacts on disk (run 'make status')"
fi

# --- 5b. Session closure authorization ------------------------------------
# A session file may only claim completion with an explicit maintainer close
# directive on record. An agent closing a session on its own authority is a
# governance defect, not a judgment call (ADR-0030, incident 2026-10-08).
if echo "$STAGED" | grep -qE '^(state/sessions/|state/REGISTRY\.md|state/INDEX\.md)'; then
    echo "pre-commit: session closure authorization"
    "${VENV}/bin/python" scripts/check_session_closure.py --quiet \
        || fail "a session claims completion without maintainer authorization (run 'make sessions')"
fi

echo "pre-commit: all gates passed."
exit 0